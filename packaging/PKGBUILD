# Maintainer: adelmonte
pkgname=xdg-desktop-portal-plain
pkgver=0.1.0
pkgrel=1
pkgdesc='Toolkit-free xdg-desktop-portal backend: settings, app chooser, notifications, inhibit, terminal prompts'
arch=('x86_64')
url='https://github.com/adelmonte/xdg-desktop-portal-plain'
license=('GPL-3.0-or-later')
depends=('xdg-desktop-portal' 'glibc' 'gcc-libs')
optdepends=('kitty: permission and app-chooser prompts (or set terminal in the config)'
            'xdg-utils: the Email portal')
makedepends=('cargo')
provides=('xdg-desktop-portal-impl')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/${CARGO_BUILD_TARGET:-.}/release/xdg-desktop-portal-plain "$pkgdir/usr/lib/xdg-desktop-portal-plain"
  install -Dm644 data/plain.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/plain.portal"
  install -Dm644 data/org.freedesktop.impl.portal.desktop.plain.service \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.plain.service"
  install -Dm644 data/config.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
